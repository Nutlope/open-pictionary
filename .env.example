# Required for live models. Without it the game runs on labelled demo guesses.
TOGETHER_API_KEY=

# Optional: signs round tickets. Defaults to a hash of TOGETHER_API_KEY.
ROUND_SECRET=

# Optional: Upstash Redis for the global leaderboard, dailies and short links.
# Without it everything lives in .data/store.json (local only).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: guard rails for the house key (visitor keys skip them).
FREE_GUESSES_PER_HOUR=900
DAILY_BUDGET_USD=40

# Optional: raises GitHub's rate limit for the star count.
GITHUB_TOKEN=

# Optional: canonical URL for share cards.
NEXT_PUBLIC_SITE_URL=
